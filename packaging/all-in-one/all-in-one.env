# regency-all-in-one: how to reach RabbitMQ and CouchDB (not installed by
# this package). Fill this file, then:
#   systemctl enable --now regency-all-in-one
#   journalctl -u regency-all-in-one -f
#
# Requirements: RabbitMQ >= 3.13 with the management and stream plugins
# (rabbitmq-plugins enable rabbitmq_management rabbitmq_stream), CouchDB 3.x
# (single node). At first start, regency creates its own least-privilege
# accounts, queues and databases with the admin credentials below (regencyctl
# init); the services never use them.
#
# Every key of the services' configuration (/etc/regency/<service>.toml) can
# be overridden here too: REGENCY_<SECTION>_<KEY>.

# RabbitMQ: AMQP, stream (port 5552 by default) and management API
REGENCY_RABBITMQ_URL=amqp://localhost:5672
REGENCY_RABBITMQ_STREAM_HOST=localhost
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_ADMIN_USER=
RABBITMQ_ADMIN_PASSWORD=

# CouchDB
REGENCY_COUCHDB_URL=http://localhost:5984
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=

# Initial password of the web UI's bootstrap admin `admin` (first start
# only). Unset: generated, logged once and kept in
# /var/lib/regency/secrets/bootstrap-admin.
#REGENCY_ADMIN_PASSWORD=

# Security levels (D19, 0 open .. 3 hardened). The all-in-one configuration
# runs at 1: authentication required, clear text tolerated. Raising them
# needs TLS material in /etc/regency/<service>.toml.
#REGENCY_SECURITY_INTERNAL=1
#REGENCY_SECURITY_EXTERNAL=1
